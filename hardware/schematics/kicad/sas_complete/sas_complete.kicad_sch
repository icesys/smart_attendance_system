  (text "Power path: 18650 -> TP4056 (charge + protection) -> switch -> MT3608 (5.0 V) -> Schottky D5 -> 5V_SYS. 3V3 comes from the ESP32-S3 board regulator."
    (at 20 268 0)
    (effects (font (size 1.6 1.6)))
    (uuid 3fd42010-0e99-409e-aa95-9a985bb7a4d2)
  )
  (text "BAT- is not ground: OUT- of the TP4056 is the system ground. LED_BLUE blinks twice every 3 s while the system is on."
    (at 20 273 0)
    (effects (font (size 1.6 1.6)))
    (uuid 7ada8062-d367-4d71-84ff-1af8f0195eec)
  )

