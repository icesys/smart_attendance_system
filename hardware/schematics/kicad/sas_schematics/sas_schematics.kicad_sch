  (text "POWER PATH: 18650 -> TP4056 (protected) -> slide switch -> MT3608 (set to 5.0 V) -> cable 2 pins 1,3 (5V_BOOST)"
    (at 200 112 0)
    (effects (font (size 1.8 1.8)))
    (uuid 306165ef-3c3f-4fd1-98b1-c8e71f709885)
  )
  (text "-> MIDDLE Schottky diode -> 5V_SYS (ESP32 5V pin, RDM6300, SD module, buzzer option). 3V3 comes from the ESP32 board."
    (at 200 119 0)
    (effects (font (size 1.8 1.8)))
    (uuid 0c9e5c7d-3e72-46d1-80e9-43ee62a6cb85)
  )
  (text "USB wins when plugged (about 5 V against 4.7 V from the battery); the battery takes over when USB is unplugged."
    (at 200 126 0)
    (effects (font (size 1.8 1.8)))
    (uuid 2aaa49af-0040-44eb-94d9-4e19a42e5861)
  )
  (text "BAT- is not ground: on the protected TP4056 it sits behind the protection chip (OUT- is the system ground)."
    (at 200 133 0)
    (effects (font (size 1.8 1.8)))
    (uuid 72c38c5a-a1bd-41da-b246-917cc0ff2036)
  )
  (text "References: TOP uses numbers 1-99, MIDDLE 101-199, BOTTOM 201-299 so they stay unique in this project."
    (at 200 140 0)
    (effects (font (size 1.8 1.8)))
    (uuid 85acfade-4a22-4411-81d9-c774256872d7)
  )

