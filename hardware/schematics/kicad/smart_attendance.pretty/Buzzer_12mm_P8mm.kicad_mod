  (fp_circle (center 4 0) (end 10 0) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_text user "+" (at -2.2 0) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
